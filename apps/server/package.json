{
  "name": "@cloud.yscope.com/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1132.0",
    "@aws-sdk/client-secrets-manager": "^3.1135.0",
    "@hono/node-server": "2.0.12",
    "@hono/standard-validator": "0.3.0",
    "@standard-schema/spec": "^1.1.0",
    "aws-ssl-profiles": "^1.1.2",
    "hono": "^4.12.32",
    "jose": "^6.2.10",
    "mongodb": "^7.5.0",
    "mysql2": "^3.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-yscope": "^1.2.0",
    "globals": "^16.5.0",
    "mongodb-memory-server": "11.2.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
