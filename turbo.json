{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@cloud.yscope.com/docs#build": {
      "dependsOn": ["^build", "clean:public"],
      "inputs": ["src/user/**", "src/conf.py", "pyproject.toml", "uv.lock", ".python-version"],
      "outputs": ["build/public/doctrees/**", "build/public/html/**"]
    },
    "@cloud.yscope.com/docs#build:internal": {
      "dependsOn": ["^build", "clean:internal"],
      "inputs": ["src/**", "pyproject.toml", "uv.lock", ".python-version"],
      "outputs": ["build/internal/doctrees/**", "build/internal/html/**"]
    },
    "@cloud.yscope.com/docs#clean:public": {
      "inputs": ["package.json"],
      "cache": false
    },
    "@cloud.yscope.com/docs#clean:internal": {
      "inputs": ["package.json"],
      "cache": false
    },
    "@cloud.yscope.com/server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@cloud.yscope.com/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".react-router/types/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@cloud.yscope.com/server#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BACKEND_HOST",
        "BACKEND_PORT",
        "MONGODB_URI"
      ]
    },
    "lint": {},
    "test": {},
    "typecheck": {},
    "@cloud.yscope.com/docs#typecheck": {
      "outputs": ["build/mypy-cache/**"]
    },
    "@cloud.yscope.com/web#typecheck": {
      "outputs": [".react-router/types/**"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    }
  }
}
