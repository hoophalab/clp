# Copy to .env and adjust for your environment. Never commit .env.
#
# VITE_* values are exposed to apps/web and must not contain secrets.
#
# ---------------------------------------------------------------------------
# Auth0 -- server
# ---------------------------------------------------------------------------
# Tenant hostname, without a scheme, port, or path.
# Auth0 Dashboard > Applications > Applications > (the console SPA) >
# Settings > Domain.
AUTH0_DOMAIN=yscope.us.auth0.com

# Auth0 API identifier. Must match VITE_AUTH0_API_AUDIENCE and use RS256.
# Auth0 Dashboard > Applications > APIs > (the cloud API) > Settings >
# Identifier.
AUTH0_API_AUDIENCE=https://cloud.yscope.com/api

# ---------------------------------------------------------------------------
# Auth0 web console
# ---------------------------------------------------------------------------
# Same tenant domain as AUTH0_DOMAIN above.
VITE_AUTH0_DOMAIN=yscope.us.auth0.com

# Dashboard > Applications > Applications > (the console SPA) > Settings >
# Client ID.
VITE_AUTH0_CLIENT_ID=edXlCj4HMJa352kTdaOZYcvJT0OTzX7y

# Must match AUTH0_API_AUDIENCE exactly, including any trailing slash. Auth0
# issues the console's access tokens for this audience, and the server accepts
# only tokens with the same audience.
VITE_AUTH0_API_AUDIENCE=https://cloud.yscope.com/api

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://username:password@localhost:27017/cloud
